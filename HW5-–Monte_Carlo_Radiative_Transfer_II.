import numpy as np

rng = np.random.default_rng(9)
sigma, R, c = 6.652e-25, 6.9634e10, 2.9979e10
n0, a, edge, h = 2.5e26, 0.096*R, 0.9*R, 0.01*R

pos = np.zeros(3)
time = 0

for steps in range(1, 100001):
    r = np.linalg.norm(pos)

    if r >= edge:
        break

    D = c*np.exp(r/a)/(3*n0*sigma)
    dt = h**2/(6*D)

    if r > 0:
        pos += D*dt*pos/(a*r)

    pos += np.sqrt(2*D*dt)*rng.normal(size=3)
    time += dt

if np.linalg.norm(pos) >= edge:
    print("Photon escaped")
    print("Steps:", steps)
    print("Escape time:", time/3.15576e7, "years")
else:
    print("Photon did not escape within the step limit")
