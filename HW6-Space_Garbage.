import numpy as np
import matplotlib.pyplot as plt

# Part (a)
z = np.linspace(-1,1,10001)
print("Forces:", np.trapz(5/(1+z*z)**1.5,z), 10/np.sqrt(2))

# Part (b)
h = .001
q = np.zeros((10001,4))
q[0] = [1,0,0,1]

def f(s):
    x,y,vx,vy = s
    r2 = x*x+y*y
    a = -10/(r2*np.sqrt(r2+1))
    return np.array([vx,vy,a*x,a*y])

for i in range(10000):
    k1 = h*f(q[i])
    k2 = h*f(q[i]+k1/2)
    k3 = h*f(q[i]+k2/2)
    k4 = h*f(q[i]+k3)
    q[i+1] = q[i]+(k1+2*k2+2*k3+k4)/6

plt.plot(q[:,0],q[:,1])
plt.axis("equal"); plt.grid(); plt.show()
